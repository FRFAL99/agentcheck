{
  "permissions": {
    "allow": ["Bash(npm test)"]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "notify-send done" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "./check.sh" }]
      }
    ]
  }
}
